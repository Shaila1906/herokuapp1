{
  "name": "herokuapp",
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "^9.4.1",
    "@wdio/local-runner": "^9.4.1",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.14",
    "@wdio/visual-service": "^6.2.2"
  },

  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "test_abtest" : "wdio wdio.conf.js --suite abtest",
    "test_addDel" : "wdio wdio.conf.js --suite addDel",
    "test_basicAuth" : "wdio wdio.conf.js --suite basicAuth",
    "test:basicAuth": "wdio wdio.conf.js --spec ./tests/specs/test.basicAuth.js"

  }
}
